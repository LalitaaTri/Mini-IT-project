<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="teamup_mmu.Features.MatchingView.MatchingView"
             xmlns:local="clr-namespace:teamup_mmu.Features.MatchingView"
             Title="Discovery">

    <VerticalStackLayout Padding="20" Spacing="15">
        
        <!-- Button to fetch the next user -->
        <Button Text="Find Someone New" 
                Command="{Binding LoadDataCommand}"
                BackgroundColor="#2196F3"
                TextColor="White"
                CornerRadius="10"
                HeightRequest="50"/>

        <!-- Display the User Data -->
        <CollectionView ItemsSource="{Binding Users}"
                        EmptyView="Tap Refresh to find teammates!">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:UserProfile">
                    <Frame HasShadow="True" 
                           BorderColor="#D1D1D1" 
                           CornerRadius="15" 
                           Margin="0,10"
                           Padding="20">
                        <VerticalStackLayout Spacing="5">
                            <!-- Matches the 'Username' property in C# -->
                            <Label Text="{Binding Username}" 
                                   FontSize="24" 
                                   FontAttributes="Bold" 
                                   TextColor="#333333"/>
                            
                            <!-- Matches the 'Faculty' and 'Program' properties -->
                            <Label Text="{Binding Faculty}" 
                                   FontSize="14" 
                                   TextColor="#2196F3" />
                            
                            <Label Text="{Binding Program}" 
                                   FontSize="14" 
                                   FontAttributes="Italic" />

                            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,10"/>

                            <Label Text="Introduction:" FontSize="12" TextColor="Gray"/>
                            <Label Text="{Binding Introduction}" 
                                   FontSize="16" 
                                   TextColor="#555555"/>

                            <Label Text="{Binding Email}" 
                                   FontSize="12" 
                                   TextColor="Gray" 
                                   Margin="0,10,0,0"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        
    </VerticalStackLayout>
</ContentPage>