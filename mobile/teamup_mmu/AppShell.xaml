<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="teamup_mmu.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:teamup_mmu"
    xmlns:features="clr-namespace:teamup_mmu.Features.MatchingView"
    Title="teamup_mmu">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="index" />
    <ShellContent
        Title="Log In"
        ContentTemplate="{DataTemplate local:SignupPage}"
        Route="signup_page"
        />
    <MenuItem Text="Log Out" 
        Clicked="OnLogoutClicked" 
        StyleClass="MenuItemLayoutStyle" />
    <ShellContent
        Title="Matching"
        ContentTemplate="{DataTemplate features:MatchingView}"
        Route="matching_page" />
</Shell>
