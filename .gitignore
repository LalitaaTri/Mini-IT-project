# 1. Ignore the 'bin' and 'obj' folders everywhere
**/bin/
**/obj/

# 2. Specifically for your mobile project root
# Ignore everything in that folder first...
mobile/teamup_mmu/*

# 3. ...BUT "un-ignore" (allow) these specific file types
!mobile/teamup_mmu/*.xaml
!mobile/teamup_mmu/*.cs
!mobile/teamup_mmu/*.csproj
!mobile/teamup_mmu/*.sln
!mobile/teamup_mmu/Platforms/

# 4. Explicitly keep the keystore OUT
mobile/*.keystore

# But "un-ignore" APK files so they can be tracked
!**/bin/**/*.apk

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
